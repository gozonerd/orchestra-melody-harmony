# Required at BUILD time. SvelteKit resolves $env/static/private at build,
# so a production build fails outright if any of these are unset.
#
# Copy to .env and fill in. Never commit the real values.

# Turso/libSQL connection. For a purely local build, "file:local.db" works.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY=
